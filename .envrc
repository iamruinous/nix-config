#!/usr/bin/env bash
# Used by https://direnv.net
source_up

# Automatically reload when this file changes
watch_file devshells/default.nix

# Load `nix develop`
use flake

# Extend the environment with per-user overrides
source_env_if_exists .envrc.local

export SEATBELT_PROFILE="permissive-open-with-tmp"
export GEMINI_SANDBOX=true

# Automatically unlock age identity when entering directory
# The decrypted key will be available at /tmp/id_age
if [[ -x .scripts/agenix-unlock.sh ]]; then
  # Unlock the age identity (will prompt for passphrase if not already unlocked)
  if .scripts/agenix-unlock.sh unlock quiet 2>/dev/null; then
    # Export the identity file path for age/agenix to use
    export SOPS_AGE_KEY_FILE="/tmp/id_age"
    export AGE_IDENTITIES_FILE="/tmp/id_age"
  else
    echo "⚠️  Age identity not unlocked. Run '.scripts/agenix-unlock.sh unlock' to unlock manually."
  fi
fi
