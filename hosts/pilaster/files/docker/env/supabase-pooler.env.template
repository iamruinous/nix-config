# Supabase Connection Pooler (Supavisor) Configuration

# Tenant ID (generate unique identifier)
POOLER_TENANT_ID=CHANGE_ME_GENERATE_UNIQUE_ID_eg_prod-pilaster

# Database connection
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME_MATCH_EXISTING_POSTGRES_PASSWORD

# Pooler settings
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

# Connection string
DATABASE_URL=postgresql://postgres:CHANGE_ME_MATCH_EXISTING_POSTGRES_PASSWORD@postgres:5432/postgres

# Secret key base (must match common env)
SECRET_KEY_BASE=CHANGE_ME_SAME_AS_SECRET_KEY_BASE_ABOVE

# Vault encryption key
VAULT_ENC_KEY=CHANGE_ME_SAME_AS_VAULT_ENC_KEY_ABOVE

# Pooling mode
POOLER_POOL_MODE=transaction

# Ports
POOLER_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543

# Region
REGION=local
FLY_APP_NAME=supabase-pooler
