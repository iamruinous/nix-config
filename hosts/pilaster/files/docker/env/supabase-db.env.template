# Supabase Database Configuration
# These should match your existing postgres container configuration

# Database Connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_MATCH_EXISTING_POSTGRES_PASSWORD

# Connection Strings
DB_HOST=postgres
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_MATCH_EXISTING_POSTGRES_PASSWORD

# Full connection strings for various services
DATABASE_URL=postgresql://postgres:CHANGE_ME_MATCH_EXISTING_POSTGRES_PASSWORD@postgres:5432/postgres
PGRST_DB_URI=postgresql://postgres:CHANGE_ME_MATCH_EXISTING_POSTGRES_PASSWORD@postgres:5432/postgres
GOTRUE_DB_DATABASE_URL=postgresql://postgres:CHANGE_ME_MATCH_EXISTING_POSTGRES_PASSWORD@postgres:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:CHANGE_ME_MATCH_EXISTING_POSTGRES_PASSWORD@postgres:5432/postgres

# PostgREST Configuration
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_ANON_ROLE=anon
PGRST_DB_USE_LEGACY_GUCS=false
PGRST_APP_SETTINGS_JWT_SECRET=CHANGE_ME_SAME_AS_JWT_SECRET_ABOVE
PGRST_JWT_SECRET=CHANGE_ME_SAME_AS_JWT_SECRET_ABOVE

# API JWT Secret (must match JWT_SECRET from common env)
API_JWT_SECRET=CHANGE_ME_SAME_AS_JWT_SECRET_ABOVE

# Postgres Meta
PG_META_CRYPTO_KEY=CHANGE_ME_GENERATE_32_CHAR_RANDOM_STRING
PG_META_PORT=8080
PG_META_DB_HOST=postgres
PG_META_DB_PORT=5432
PG_META_DB_NAME=postgres
PG_META_DB_USER=postgres
PG_META_DB_PASSWORD=CHANGE_ME_MATCH_EXISTING_POSTGRES_PASSWORD

# PGDATA path (already set in main postgres container)
PGDATA=/var/lib/postgresql/18/docker
