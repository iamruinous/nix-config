# Supabase Analytics (Logflare) Configuration

# Generate with: head -c 16 /dev/urandom | base64 | tr -d '=+/'
LOGFLARE_PUBLIC_ACCESS_TOKEN=CHANGE_ME_GENERATE_RANDOM_TOKEN
LOGFLARE_PRIVATE_ACCESS_TOKEN=CHANGE_ME_GENERATE_RANDOM_TOKEN

# Database connection for analytics
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_MATCH_EXISTING_POSTGRES_PASSWORD
DB_DATABASE=postgres
DB_HOSTNAME=postgres
DB_PORT=5432

# Backend URL
POSTGRES_BACKEND_URL=postgresql://postgres:CHANGE_ME_MATCH_EXISTING_POSTGRES_PASSWORD@postgres:5432/postgres

# API URL
LOGFLARE_API_KEY=CHANGE_ME_SAME_AS_SERVICE_ROLE_KEY

# Node environment
PHOENIX_ENV=production

# Single Tenant Mode
SINGLE_TENANT=true

# Logflare configuration
LOGFLARE_NODE_HOST=analytics

# Supabase-specific
LOGFLARE_SUPABASE_MODE=true
