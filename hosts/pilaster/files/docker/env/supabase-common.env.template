# Supabase Common Environment Variables
# Generate secrets with: head -c 32 /dev/urandom | base64 | tr -d '=+/' | head -c 64

# JWT Secret (64+ characters, alphanumeric)
JWT_SECRET=CHANGE_ME_GENERATE_64_CHAR_RANDOM_STRING

# API Keys (generate with: https://supabase.com/docs/guides/self-hosting#api-keys)
# Or use JWT generator with your JWT_SECRET
ANON_KEY=CHANGE_ME_GENERATE_ANON_JWT_TOKEN
SERVICE_ROLE_KEY=CHANGE_ME_GENERATE_SERVICE_ROLE_JWT_TOKEN

# Dashboard Credentials
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Encryption Keys (32+ characters each)
SECRET_KEY_BASE=CHANGE_ME_GENERATE_32_CHAR_RANDOM_STRING
VAULT_ENC_KEY=CHANGE_ME_GENERATE_32_CHAR_RANDOM_STRING

# Site Configuration
SITE_URL=https://supabase.meskill.farm
API_EXTERNAL_URL=https://supabase.meskill.farm
SUPABASE_PUBLIC_URL=https://supabase.meskill.farm

# Additional URLs
SUPABASE_URL=https://supabase.meskill.farm
POSTGREST_URL=http://rest:3000
IMGPROXY_URL=http://imgproxy:5001

# File Upload Limits
FILE_SIZE_LIMIT=52428800
UPLOAD_FILE_SIZE_LIMIT=52428800

# JWT Configuration
JWT_EXPIRY=3600
GOTRUE_JWT_EXP=3600

# Email Configuration (OPTIONAL - set if enabling email auth)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user@example.com
SMTP_PASS=smtp_password
SMTP_SENDER_NAME=Supabase
SMTP_ADMIN_EMAIL=admin@example.com

# Auth Configuration
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# HTTPS/TLS (handled by Caddy)
GOTRUE_DISABLE_SIGNUP=false
