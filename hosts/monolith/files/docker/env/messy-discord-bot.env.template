# Messy Discord Bot Environment Variables
# Fill in the values below, then encrypt with:
#   agenix edit -i messy-discord-bot.env.template messy-discord-bot.env.age
# Then delete this template file.

# Discord bot token from Discord Developer Portal
# https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_from_discord_developer_portal

# n8n webhook URL for the Discord assistant workflow
N8N_WEBHOOK_URL=https://n8n.meskill.farm/webhook/discord-assistant

# Discord channel ID to listen for messages
# Right-click channel in Discord -> Copy Channel ID (requires Developer Mode)
MESSY_CHANNEL_ID=channel_id_for_messy_chat
